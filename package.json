{
  "name": "hidayah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-no-emdash.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:contrast",
    "generate-vapid": "node scripts/generate-vapid.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@upstash/qstash": "^2.11.3",
    "@upstash/redis": "^1.38.2",
    "adhan": "^4.4.4",
    "framer-motion": "^13.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "description": "Prayer times, the Hijri calendar and the full Quran with translation, tafsir and recitation.",
  "license": "MIT"
}
