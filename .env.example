# Hidayah environment variables
#
# Every variable below is optional for local development. Without them the app
# still runs, and the prayer alarm falls back to an in tab alarm that works
# while the site is open. The variables are only needed for background push
# notifications that fire when the site is closed.

# Web Push identity. Generate a pair with: npm run generate-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis, stores push subscriptions. https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash, delivers each prayer notification at its exact time.
# Copy all four from the region you picked in the QStash console. The token and
# the signing keys are per region, so mixing an EU token with US signing keys
# makes every callback fail signature verification.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public origin of the deployment, used to build QStash callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret guarding the daily cron route. Vercel sends this automatically.
CRON_SECRET=
